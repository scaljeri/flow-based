{
  "extends": "./tsconfig.lib.json",
  "compilerOptions": {
    "declarationMap": false
  },
  "angularCompilerOptions": {
    /*
     * "partial", the recommended mode, which this package could not use while it
     * contained its own view layer: FlowBasedComponent and NodeComponent were
     * mutually recursive templates, and the "remote scoping" that resolves such a
     * cycle is only implemented for full compilation. Full compilation costs
     * Angular-linker compatibility, which is a real constraint on consumers.
     *
     * The cycle went with NodeComponent. This package now declares one component,
     * whose template is a web component.
     */
    "compilationMode": "partial"
  }
}

{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/spec",
    "types": ["vitest/globals"]
  },
  /*
   * All sources, not just specs: the library's components are `standalone: false`,
   * so FlowBasedModule has to be in the program for their template scope to
   * resolve. With only `*.spec.ts` here, every component binding fails NG8002.
   */
  "include": ["src/**/*.ts"]
}

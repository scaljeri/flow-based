{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": ["vitest/globals"]
  },
  /*
   * All sources, not just specs: the app's components are `standalone: false`,
   * so AppModule has to be in the program for their template scope to resolve.
   * With only `*.spec.ts` here, every Material binding fails NG8002.
   */
  "include": ["src/**/*.ts"]
}

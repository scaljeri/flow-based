{
  "name": "@scaljeri/flow-based-demo",
  "version": "0.0.1",
  "private": false,
  "packageManager": "npm@11.17.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run build:lib && ng serve",
    "build": "npm run build:lib",
    "build:lib": "npm run build:lit && ng build @scaljeri/flow-based",
    "build:demo": "npm run build:lib && ng build flow-based-demo",
    "watch:lib": "ng build @scaljeri/flow-based --watch --configuration development",
    "test": "ng test @scaljeri/flow-based-core && ng test @scaljeri/flow-based && ng test flow-based-demo",
    "test:lib": "ng test @scaljeri/flow-based",
    "lint": "ng lint",
    "e2e": "playwright test",
    "ngh": "npm run build:demo -- --base-href \"https://scaljeri.github.io/flow-based/\" && ngh --dir=dist/demo/browser",
    "build:core": "ng build @scaljeri/flow-based-core",
    "test:core": "ng test @scaljeri/flow-based-core",
    "build:lit": "npm run build:core && ng build @scaljeri/flow-based-lit",
    "build:lit-demo": "npm run build:lit && node scripts/build-lit-demo.mjs",
    "serve:lit-demo": "node scripts/serve-static.mjs dist/lit-demo 4400",
    "build:e2e": "npm run build:lib && node scripts/build-lit-demo.mjs"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.7",
    "google-charts": "^2.0.0",
    "lit": "^3.3.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.0",
    "@angular/cli": "^22.1.0",
    "@angular/compiler-cli": "^22.1.0",
    "@playwright/test": "^1.62.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "angular-cli-ghpages": "^3.1.0",
    "angular-eslint": "^22.1.0",
    "eslint": "^9.39.0",
    "jsdom": "^28.1.0",
    "katex": "^0.18.1",
    "ng-packagr": "^22.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^4.1.10"
  }
}
